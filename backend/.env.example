# App
SECRET_KEY=your_app_secret_key_here
DEBUG=False
ALLOWED_ORIGINS=https://t.me,https://school21-p2p.vercel.app

# Database (all run inside the same container on localhost)
DATABASE_URL=postgresql+asyncpg://peerlearn:strongpassword@localhost:5432/peer_learn
REDIS_URL=redis://localhost:6379/0

# School21
SCHOOL21_API_BASE=https://platform.21-school.ru/services/21-school/api/v1
FERNET_KEY=your_fernet_key_base64_here

# JWT
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24
REFRESH_TOKEN_EXPIRE_DAYS=7

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_URL=https://yourdomain.com/bot/webhook
TELEGRAM_REQUIRED_CHANNEL=-1003320951856
ADMIN_IDS=5678281376

# Telegram DevOps Logger (GitHub / Vercel / Error Alerts)
TELEGRAM_LOGGER_BOT_TOKEN=
TELEGRAM_LOGGER_CHAT_ID=

# Celery (redis inside the same container)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Render port (Render sets this automatically, default 8000)
PORT=8000
